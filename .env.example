# ---- PAINEL ADMIN (Opção A) · GitHub + Auto-redeploy Vercel ----
# 1) Crie em https://github.com/settings/tokens · Permissão "repo" (Full control of private repositories)
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2) Repositório (formato owner/repo)
GITHUB_REPO=Edblas/SiteGabi
# 3) Branch de deploy (default main)
GITHUB_BRANCH=main
# 4) Hash bcrypt da senha da Gabi (gerar via: POST /api/admin/login com body { "_generateHash": "SENHA_DA_GABI" })
ADMIN_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 5) Segredo para JWT de 7 dias (troque por uma string longa e aleatória)
ADMIN_JWT_SECRET=trocar-por-string-secreta-grande-ex-256bits
